#!/usr/bin/env bash
# Health checks for the shell (atuin.md): `atuin-sync`, history synced recently.
# (`atuin-vars` was retired 2026-11-06: atuin 18.24 made dotfile vars read-only
# legacy data that is no longer exported, so a finding there can't be fixed.)
set -u

# shellcheck source=bin/health-lib.sh
source "$(dirname "$0")/../bin/health-lib.sh"

atuin_sync() {
  local out rc=0 when stamp age max=${ATUIN_SYNC_MAX_AGE_HOURS:-24}
  out=$(atuin status 2>/dev/null) || rc=$?
  if ((rc != 0)); then
    report "FAIL atuin-sync: atuin status exited $rc"
    return
  fi
  # "Last sync: 2026-11-06 14:57:47.347674749 +01:00:00" -> "2026-11-06 14:57:47 +01:00";
  # the hour is not zero-padded ("0:15:46")
  local re='^Last sync: ([0-9-]{10} [0-9]{1,2}:[0-9]{2}:[0-9]{2})(\.[0-9]+)? ([+-][0-9]{2}:[0-9]{2})(:[0-9]{2})?$'
  when=$(sed -nE "s/$re/\\1 \\3/p" <<<"$out" | head -1)
  if [[ -z $when ]] || ! stamp=$(date -d "$when" +%s 2>/dev/null); then
    report "FAIL atuin-sync: no Last sync: line"
    return
  fi
  age=$(($(date +%s) - stamp))
  if ((age < max * 3600)); then
    report "ok atuin-sync: $((age / 3600))h ago"
  else
    report "FAIL atuin-sync: last sync $((age / 3600))h ago"
  fi
}

if need atuin-sync atuin; then atuin_sync; fi
exit "$failed"
