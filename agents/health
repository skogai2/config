#!/usr/bin/env bash
# Health checks for agents (herdr.md): `herdr-config` not reset to stock,
# `herdr-binary` is mise's (not Omarchy's /usr/bin/herdr), and
# `herdr-integrations` has none broken, and `herdr-app-layout` (herdr-app.md)
# still has lazyvim with its herdr-nvim patch, agenttrail block, keys and
# herdr-nvim runtime. HERDR_OMARCHY_BIN and
# HERDR_APP_HOME override the paths.
set -u

# shellcheck source=bin/health-lib.sh
source "$(dirname "$0")/../bin/health-lib.sh"

herdr_binary() {
  local path omarchy=${HERDR_OMARCHY_BIN:-/usr/bin/herdr}
  path=$(command -v herdr)
  if [[ $path == "$omarchy" ]]; then
    report "FAIL herdr-binary: $path is Omarchy's herdr; mise's must come first on PATH"
  else
    report "ok herdr-binary: $(tilde "$path")"
  fi
}

herdr_integrations() {
  local out rc=0 summary current broken
  out=$(herdr integration status 2>/dev/null) || rc=$?
  if ((rc != 0)); then
    report "FAIL herdr-integrations: herdr integration status exited $rc"
    return
  fi
  # "name: state (vN) (path)" -> count current; collect anything not installed/current.
  summary=$(awk '
    i = index($0, ": ") {
      name = substr($0, 1, i - 1); state = substr($0, i + 2)
      j = index(state, " ("); if (j) state = substr(state, 1, j - 1)
      if (state == "current") n++
      else if (state != "not installed") bad = bad (bad == "" ? "" : ", ") name " " state
    }
    END { print n + 0 "\t" bad }' <<<"$out")
  current=${summary%%$'\t'*}
  broken=${summary#*$'\t'}
  if [[ -n $broken ]]; then
    report "FAIL herdr-integrations: $broken"
  else
    report "ok herdr-integrations: $current current"
  fi
}

# The lazyvim layout, its herdr-nvim patch and its keys (herdr-app.md): a sync
# from origin or a herdr-app change has removed them before.
herdr_app_layout() {
  local dir=${HERDR_APP_HOME:-$HOME/.config/herdr-app} missing=()
  local layout=$dir/layouts/lazyvim.json keys=$dir/keys.json runtime
  local launcher=$dir/mods/herdr-nvim/bin/herdr-nvim
  if [[ ! -f $layout ]]; then
    report "FAIL herdr-app-layout: $(tilde "$layout") not found (reinstall: agents/herdr-app.md)"
    return
  fi
  jq -e '[.. | objects | select(.id? == "herdr-nvim-sync")] | length > 0' "$layout" >/dev/null 2>&1 ||
    missing+=("herdr-nvim patch (rerun its installer)")
  jq -e '[.. | objects | select(.id? == "agenttrail")] | length > 0' "$layout" >/dev/null 2>&1 ||
    missing+=("agenttrail block")
  jq -e 'has("layout:lazyvim")' "$keys" >/dev/null 2>&1 || missing+=("layout:lazyvim keys")
  # The mod's launcher execs a runtime outside the mod folder; `herdr-app check`
  # passes without it, but cmd-e can't start.
  if [[ -f $launcher ]]; then
    runtime=$(sed -n "s#^exec '\([^']*\)'.*#\1#p" "$launcher")
    [[ -n $runtime && -x $runtime ]] ||
      missing+=("herdr-nvim runtime $(tilde "${runtime:-?}") (rerun its installer)")
  else
    missing+=("herdr-nvim launcher (rerun its installer)")
  fi
  if ((${#missing[@]})); then
    report "FAIL herdr-app-layout: lazyvim lacks $(join ', ' "${missing[@]}") (agents/herdr-app.md)"
  else
    report "ok herdr-app-layout: lazyvim"
  fi
}

stock_check herdr-config herdr/config.toml agents/herdr.md
if need herdr-app-layout jq; then herdr_app_layout; fi
if need herdr-binary herdr; then herdr_binary; fi
if need herdr-integrations herdr; then herdr_integrations; fi
exit "$failed"
