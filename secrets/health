#!/usr/bin/env bash
# Health checks for secrets (fnox.md): `ssh-dir`, `age-keys` and `fnox-config`
# permissions. Reads modes and owners only, never file contents.
# FNOX_CONFIG / FNOX_CONFIG_OWNER override /etc/skogai/fnox.toml / root.
set -u

# shellcheck source=bin/health-lib.sh
source "$(dirname "$0")/../bin/health-lib.sh"

user=$(id -un)

ssh_dir() {
  local mode
  if [[ ! -d $HOME/.ssh ]]; then
    report "FAIL ssh-dir: ~/.ssh not found"
    return
  fi
  mode=$(stat -c '%a %U' "$HOME/.ssh")
  if [[ $mode == "700 $user" ]]; then
    report "ok ssh-dir"
  else
    report "FAIL ssh-dir: ~/.ssh is $mode, want 700 $user"
  fi
}

age_keys() {
  local f mode n=0 bad=()
  for f in "$HOME"/.ssh/*age*.txt; do
    [[ -f $f ]] || continue
    n=$((n + 1))
    mode=$(stat -c '%a %U' "$f")
    [[ $mode == "600 $user" ]] || bad+=("$(basename "$f") $mode")
  done
  if ((${#bad[@]})); then
    report "FAIL age-keys: $(join ', ' "${bad[@]}")"
  else
    report "ok age-keys: $n keys"
  fi
}

fnox_config() {
  local file=${FNOX_CONFIG:-/etc/skogai/fnox.toml} owner=${FNOX_CONFIG_OWNER:-root}
  local dir mode wrong=()
  if [[ ! -e $file ]]; then
    report "ok fnox-config: not deployed"
    return
  fi
  dir=$(dirname "$file")
  mode=$(stat -c '%a %U' "$file")
  [[ $mode == "644 $owner" ]] || wrong+=("$file is $mode")
  mode=$(stat -c '%a %U' "$dir")
  [[ $mode == "755 $owner" ]] || wrong+=("$dir is $mode")
  if ((${#wrong[@]})); then
    report "FAIL fnox-config: $(join '; ' "${wrong[@]}"), want 644/755 $owner"
  else
    report "ok fnox-config"
  fi
}

ssh_dir
age_keys
fnox_config
exit "$failed"
