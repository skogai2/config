#!/usr/bin/env bash
# Health check for the machine: `failed-units`, the failed systemd user units.
# Contract: bin/health. FAILED_UNITS_IGNORE: space-separated units that notify
# on their own (skogai-health.service sets it), reported but not failed.
set -u

if ! command -v systemctl >/dev/null; then
  echo "FAIL failed-units: systemctl not found"
  exit 1
fi

rc=0
out=$(systemctl --user --failed --no-legend --plain 2>/dev/null) || rc=$?
if ((rc != 0)); then
  echo "FAIL failed-units: systemctl exited $rc"
  exit 1
fi
units="" ignored=""
while read -r unit _; do
  [[ -n $unit ]] || continue
  if [[ " ${FAILED_UNITS_IGNORE:-} " == *" $unit "* ]]; then
    ignored+=${ignored:+, }$unit
  else
    units+=${units:+, }$unit
  fi
done <<<"$out"
if [[ -n $units ]]; then
  echo "FAIL failed-units: $units"
  exit 1
fi
echo "ok failed-units${ignored:+: ignored $ignored}"
