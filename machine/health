#!/usr/bin/env bash
# Health check for the machine: `failed-units`, the failed systemd user units.
# Contract: bin/health.
set -u

if ! command -v systemctl >/dev/null; then
  echo "FAIL failed-units: systemctl not found"
  exit 1
fi

rc=0
out=$(systemctl --user --failed --no-legend --plain 2>/dev/null) || rc=$?
if ((rc != 0)); then
  echo "FAIL failed-units: systemctl exited $rc"
  exit 1
fi
units=$(awk 'NF { s = s (s == "" ? "" : ", ") $1 } END { print s }' <<<"$out")
if [[ -n $units ]]; then
  echo "FAIL failed-units: $units"
  exit 1
fi
echo "ok failed-units"
