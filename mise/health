#!/usr/bin/env bash
# Health checks for mise: `doctor` problems, `bootstrap-plan` drift,
# `dot-capture` (the dotfile watcher) and `dot-sync` (any ✗ line in
# `mise dot status`, e.g. a failing publish) and `coverage` (every ~/.config
# entry tracked or decided, ../bin/check-coverage). Contract: bin/health.
# Only problem lines and the Plan: summary are ever printed; never mise env.
set -u

checks=(doctor bootstrap-plan dot-capture dot-sync coverage)
here=$(cd "$(dirname "$0")/.." && pwd)
failed=0

report() {
  echo "$1"
  [[ $1 == FAIL* ]] && failed=1
  return 0
}

doctor() {
  local out rc=0 problems
  out=$(mise doctor 2>&1) || rc=$?
  # Numbered lines of the "N problem(s) found:" block, joined with "; ".
  problems=$(awk '
    /^[0-9]+ problems? found:$/ { p = 1; found = 1; next }
    /^[0-9]+ (warnings?|problems?) found:$/ { p = 0 }
    p && /^[0-9]+\. / { sub(/^[0-9]+\. /, ""); s = s (s == "" ? "" : "; ") $0 }
    END { if (found) print "found:" s }
  ' <<<"$out")
  if [[ -n $problems ]]; then
    report "FAIL doctor: ${problems#found:}"
  elif ((rc != 0)); then
    report "FAIL doctor: mise doctor exited $rc"
  else
    report "ok doctor"
  fi
}

bootstrap_plan() {
  local out rc=0 line
  out=$(mise bootstrap plan 2>/dev/null) || rc=$?
  line=$(grep -m1 '^Plan: ' <<<"$out")
  if [[ -z $line ]]; then
    report "FAIL bootstrap-plan: no Plan: line (exit $rc)"
  elif grep -qE '(: |, )[1-9][0-9]* (create|update|remove|unknown)' <<<"$line"; then
    report "FAIL bootstrap-plan: $line"
  else
    report "ok bootstrap-plan: $line"
  fi
}

# `mise dot status` exits 0 even when sync fails, so both dot checks read
# its output: run it once, here.
dot_status() {
  dot_rc=0
  dot_out=$(mise dot status 2>/dev/null) || dot_rc=$?
}

dot_capture() {
  local out=$dot_out state
  if ((dot_rc != 0)); then
    report "FAIL dot-capture: mise dot status exited $dot_rc"
    return
  fi
  # The first non-blank line after "Automatic capture", leading space trimmed.
  state=$(awk '
    { sub(/^[ \t]+/, "") }
    seen && $0 != "" { print; exit }
    /^Automatic capture/ { seen = 1 }
  ' <<<"$out")
  if [[ $state == running* ]]; then
    report "ok dot-capture"
  else
    report "FAIL dot-capture: automatic capture not running"
  fi
}

# Every line marked ✗, up to its first ". " (the error, not the advice).
dot_sync() {
  local errors
  if ((dot_rc != 0)); then
    report "FAIL dot-sync: mise dot status exited $dot_rc"
    return
  fi
  errors=$(awk '
    { sub(/^[ \t]+/, "") }
    /^\xe2\x9c\x97 / { sub(/^\xe2\x9c\x97 /, ""); sub(/\. .*/, ""); s = s (s == "" ? "" : "; ") $0 }
    END { print s }
  ' <<<"$dot_out")
  if [[ -n $errors ]]; then
    report "FAIL dot-sync: $errors"
  else
    report "ok dot-sync"
  fi
}

# coverage: bin/check-coverage's summary; on a miss, the names it flagged.
coverage() {
  local out rc=0 summary names
  out=$("$here/bin/check-coverage" 2>/dev/null) || rc=$?
  summary=$(tail -1 <<<"$out")
  if ((rc == 0)); then
    report "ok coverage: $summary"
  elif ((rc == 1)); then
    names=$(sed -nE 's/^(CONFLICT|UNDECIDED) //p' <<<"$out" | awk '{printf "%s%s", (NR > 1 ? ", " : ""), $0}')
    report "FAIL coverage: ${summary#* tracked, * decided, }: $names"
  else
    report "FAIL coverage: check-coverage exited $rc"
  fi
}

main() {
  local c
  if ! command -v mise >/dev/null; then
    for c in "${checks[@]}"; do echo "FAIL $c: mise not found"; done
    return 1
  fi
  cd "$HOME" || return 1
  doctor
  bootstrap_plan
  dot_status
  dot_capture
  dot_sync
  coverage
  return "$failed"
}

main
