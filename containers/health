#!/usr/bin/env bash
# Health check for the podman quadlets: wraps quadlet-health (see podman.md).
# Contract: bin/health. QUADLET_HEALTH overrides the script's path.
set -u

# The stack is workstation-only (podman.md, 2026-11-20): a host without the
# checkout has nothing to check. QUADLET_DIR overrides the checkout path.
dir=${QUADLET_DIR:-$HOME/.config/containers/systemd}
if [[ -z ${QUADLET_HEALTH:-} && ! -d $dir ]]; then
  echo "ok quadlet-health: no quadlet stack on this host"
  exit 0
fi
qh=${QUADLET_HEALTH:-$dir/bin/quadlet-health}
if [[ ! -f $qh || ! -x $qh ]]; then
  echo "FAIL quadlet-health: $qh not found"
  exit 1
fi

rc=0
out=$("$qh" 2>/dev/null) || rc=$?
if ((rc != 0)); then
  echo "FAIL quadlet-health: exit $rc, see quadlet-health"
  exit 1
fi
units=$(sed -nE 's/^generator: .*, ([0-9]+) units$/\1/p' <<<"$out" | head -1)
echo "ok quadlet-health: ${units:-?} units"
